# MySQL, matching prisma/schema.prisma's datasource provider.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE_NAME"
AUTH_SECRET="generate-a-random-secret"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# From https://resend.com/api-keys — used by src/lib/email.ts for all outbound mail.
RESEND_API_KEY=""
# Sender address for outbound mail (must be a verified domain/sender in Resend).
EMAIL_FROM=""
# From https://dashboard.stripe.com/test/apikeys — test mode keys are fine for dev.
STRIPE_SECRET_KEY="sk_test_..."
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` (Stripe CLI), or the
# dashboard webhook endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET="whsec_..."
# Directory where media of emergency-taken-down articles are quarantined (ETAP 13.3C.2).
# Leave empty for local development/tests (falls back to ./private/quarantine/uploads).
# PRODUCTION: set an absolute path that is OUTSIDE the public web root, persistent across
# deploys and writable by the application process. Never point it into public/.
# See docs/QUARANTINE_DEPLOYMENT.md.
QUARANTINE_DIR=""
